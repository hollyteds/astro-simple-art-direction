---
import '../type.d.ts';
import { getBackground } from '../renderers/getBackground.ts';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<tagName> {
	TagName?: tagName;
	image: {
		src: src;
		format?: format;
	}
}

const {
	TagName = "div",
	image,
	...props
} = Astro.props;

const { slot, ...restProps } = props as typeof props & { slot?: string | null };
const cleanedProps: Omit<typeof props, 'slot'> & { slot?: string } =
  slot == null ? restProps : { ...restProps, slot };

const {
  style: inlineStyle,
  ...restCleanedProps
} = cleanedProps as typeof cleanedProps & { style?: string | null };

const {src, format } = image;

const backgroundImage = await getBackground(src, format);

const mergedStyle = [inlineStyle, `background-image: url(${backgroundImage});`]
  .filter((value): value is string => typeof value === 'string' && value.trim().length > 0)
  .join(';');
---
<TagName {...restCleanedProps} style={mergedStyle}>
  <slot/>
</TagName>
