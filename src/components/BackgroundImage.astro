---
import '../type.d.ts';
import { getBackground } from '../renderers/getBackground.ts';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<tagName> {
	TagName?: tagName;
	image: {
		src: src;
		format?: format;
	}
}

const {
	TagName = "div",
	image,
	...props
} = Astro.props;

const { slot, ...restProps } = props as typeof props & { slot?: string | null };
const cleanedProps: Omit<typeof props, 'slot'> & { slot?: string } =
  slot == null ? restProps : { ...restProps, slot };

const {src, format } = image;

const backgroundImage = await getBackground(src, format);
---
<TagName {...cleanedProps} style={`background-image: url(${backgroundImage});`}>
  <slot/>
</TagName>
